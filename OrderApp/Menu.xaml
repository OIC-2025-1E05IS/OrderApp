<Window x:Class="OrderApp.Menu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ラーメン券売機"
        Height="700"
        Width="450"
        Background="#fffdff35"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#999999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="FlatTabTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderThickness="0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="145"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#222222">
            <Button x:Name="Top_btn" Content="◆TOPに戻る"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="8,0"
                    Padding="6,3"
                    Background="#444444"
                    Foreground="White"
                    BorderBrush="#888888"
                    FontSize="11" Click="Top_btn_Click"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="8,0">
                <Button Content="English" Margin="2" Padding="5,2" FontSize="10"/>
                <Button Content="中文(簡体)" Margin="2" Padding="5,2" FontSize="10"/>
                <Button Content="한국어" Margin="2" Padding="5,2" FontSize="10"/>
            </StackPanel>
        </Grid>

        <Viewbox Grid.Row="1" Stretch="Uniform">
            <Grid Width="450" Height="520">
                <Grid.RowDefinitions>
                    <RowDefinition Height="315"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="285"/>
                    <ColumnDefinition Width="165"/>
                </Grid.ColumnDefinitions>

                <!-- 上：ラーメン選択欄 -->
                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="12,4,12,2">

                    <UniformGrid Columns="3" Height="30" Margin="0,0,150,4">
                        <Button x:Name="BtnTabRamen"
                                Content="ラーメン"
                                Tag="Ramen"
                                Click="Tab_Click"
                                Background="#CC1111"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="12"
                                Margin="1,0"
                                Template="{StaticResource FlatTabTemplate}"/>

                        <Button x:Name="BtnTabSoupless"
                                Content="汁なし"
                                Tag="Soupless"
                                Click="Tab_Click"
                                Background="#333333"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="12"
                                Margin="1,0"
                                Template="{StaticResource FlatTabTemplate}"/>

                        <Button x:Name="BtnTabTsukemen"
                                Content="つけ麺"
                                Tag="Tsukemen"
                                Click="Tab_Click"
                                Background="#333333"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="12"
                                Margin="1,0"
                                Template="{StaticResource FlatTabTemplate}"/>
                    </UniformGrid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="BrandCategoryText"
                                       Text="ラーメン"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="Red"/>
                            <TextBlock Text="山豚"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="Black"/>
                        </StackPanel>

                        <UniformGrid Grid.Column="1" Columns="3">
                            <StackPanel Margin="2">
                                <Border Background="Transparent" CornerRadius="4" ClipToBounds="True">
                                    <Image x:Name="ImgLeft"
                                     Source="pack://application:,,,/Images/Main.png"
                                     Stretch="Uniform"
                                     Height="88"/>
                                </Border>
                                <Border Background="#FFCC00" CornerRadius="3" Padding="2" Margin="0,1,0,0">
                                    <TextBlock x:Name="HeaderMiniText"
                                               Text="ミニラーメン&#x0a;(麺125g)"
                                               FontWeight="Bold"
                                               FontSize="8"
                                               TextAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="2">
                                <Border Background="Transparent" CornerRadius="4" ClipToBounds="True">
                                    <Image x:Name="ImgCenter"
                                     Source="pack://application:,,,/Images/Main.png"
                                     Stretch="Uniform"
                                     Height="88"/>
                                </Border>
                                <Border Background="#FF8800" CornerRadius="3" Padding="2" Margin="0,1,0,0">
                                    <TextBlock x:Name="HeaderSmallText"
                                               Text="小ラーメン&#x0a;(麺250g)"
                                               FontWeight="Bold"
                                               FontSize="8"
                                               Foreground="White"
                                               TextAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="2">
                                <Border Background="Transparent" CornerRadius="4" ClipToBounds="True">
                                    <Image x:Name="ImgRight"
                                     Source="pack://application:,,,/Images/Main.png"
                                     Stretch="Uniform"
                                     Height="88"/>
                                </Border>
                                <Border Background="#CC2200" CornerRadius="3" Padding="2" Margin="0,1,0,0">
                                    <TextBlock x:Name="HeaderLargeText"
                                               Text="大ラーメン&#x0a;(麺375g)"
                                               FontWeight="Bold"
                                               FontSize="8"
                                               Foreground="White"
                                               TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </UniformGrid>
                    </Grid>

                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#CC1111" CornerRadius="20" Margin="2">
                            <TextBlock Text="豚2枚" Foreground="White" FontWeight="Bold"
                                       FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <UniformGrid Grid.Column="1" Columns="3">
                            <Button Margin="1" Height="42" Click="Menu_Click">
                                <StackPanel>
                                    <TextBlock x:Name="MenuR0C0Name" Text="ミニラーメン" FontSize="9" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="MenuR0C0Price" Text="950円" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Margin="1" Height="42" Click="Menu_Click" BorderBrush="#FF8800" BorderThickness="2">
                                <StackPanel>
                                    <TextBlock x:Name="MenuR0C1Name" Text="小ラーメン" FontSize="9" Foreground="OrangeRed" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="MenuR0C1Price" Text="1,000円" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Margin="1" Height="42" Click="Menu_Click">
                                <StackPanel>
                                    <TextBlock x:Name="MenuR0C2Name" Text="大ラーメン" FontSize="9" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="MenuR0C2Price" Text="1,100円" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Grid>

                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#CC1111" CornerRadius="20" Margin="2">
                            <TextBlock Text="豚5枚" Foreground="White" FontWeight="Bold"
                                       FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <UniformGrid Grid.Column="1" Columns="3">
                            <Button Margin="1" Height="42" Click="Menu_Click">
                                <StackPanel>
                                    <TextBlock x:Name="MenuR1C0Name" Text="ミニぶた" FontSize="9" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="MenuR1C0Price" Text="1,200円" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Margin="1" Height="42" Click="Menu_Click">
                                <StackPanel>
                                    <TextBlock x:Name="MenuR1C1Name" Text="小ぶた" FontSize="9" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="MenuR1C1Price" Text="1,250円" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Margin="1" Height="42" Click="Menu_Click">
                                <StackPanel>
                                    <TextBlock x:Name="MenuR1C2Name" Text="大ぶた" FontSize="9" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="MenuR1C2Price" Text="1,350円" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Grid>

                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#CC1111" CornerRadius="20" Margin="2">
                            <TextBlock Text="豚8枚" Foreground="White" FontWeight="Bold"
                                       FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <UniformGrid Grid.Column="1" Columns="3">
                            <Button Margin="1" Height="42" Click="Menu_Click">
                                <StackPanel>
                                    <TextBlock x:Name="MenuR2C0Name" Text="ミニぶたダブル" FontSize="8" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="MenuR2C0Price" Text="1,400円" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Margin="1" Height="42" Click="Menu_Click">
                                <StackPanel>
                                    <TextBlock x:Name="MenuR2C1Name" Text="小ぶたダブル" FontSize="8" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="MenuR2C1Price" Text="1,450円" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Margin="1" Height="42" Click="Menu_Click">
                                <StackPanel>
                                    <TextBlock x:Name="MenuR2C2Name" Text="大ぶたダブル" FontSize="8" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="MenuR2C2Price" Text="1,550円" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Grid>
                </StackPanel>

                <!-- 左下：トッピング欄 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="12,2,4,4">
                    <Border Background="#111111" Margin="0,0,0,2" Padding="3,2" CornerRadius="2">
                        <TextBlock Text="★追加トッピング★"
                                   Foreground="Red"
                                   HorizontalAlignment="Center"
                                   FontWeight="Bold"
                                   FontSize="10"/>
                    </Border>

                    <UniformGrid Columns="3">
                        <Button Content="生玉子 50円" Margin="1" Height="26" FontSize="9" Click="Topping_Click"/>
                        <Button Content="肉あぶら 150円" Margin="1" Height="26" FontSize="9" Click="Topping_Click"/>
                        <Button Content="味玉 100円" Margin="1" Height="26" FontSize="9" Click="Topping_Click"/>
                        <Button Content="黒烏龍茶 100円" Margin="1" Height="26" FontSize="9" Click="Topping_Click"/>
                        <Button Content="うずら5個 100円" Margin="1" Height="26" FontSize="9" Click="Topping_Click"/>
                        <Button Content="辛ニラ 100円" Margin="1" Height="26" FontSize="9" Click="Topping_Click"/>
                        <Button Content="白髪ネギ 100円" Margin="1" Height="26" FontSize="9" Click="Topping_Click"/>
                        <Button Content="粉チーズ 100円" Margin="1" Height="26" FontSize="9" Click="Topping_Click"/>
                        <Button Content="マヨネーズ 50円" Margin="1" Height="26" FontSize="9" Click="Topping_Click"/>
                    </UniformGrid>

                    <UniformGrid Columns="3" Margin="0,4,0,0">
                        <Button Content="ライス&#x0a;150円" Margin="1" Height="28" FontSize="9" Click="Topping_Click"/>
                        <Button Content="麺増し125g&#x0a;100円" Margin="1" Height="28" FontSize="9" Click="Topping_Click"/>
                        <Button Content="黒烏龍茶&#x0a;200円" Margin="1" Height="28" FontSize="9"
                                Background="#222222" Foreground="White" Click="Topping_Click"/>
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,1,0,0">
                        <Button Content="大ライス 200円" Margin="1" Height="28" FontSize="9" Click="Topping_Click"/>
                        <Button Content="お持ち帰り豚 500円" Margin="1" Height="28" FontSize="8"
                                BorderBrush="Red" BorderThickness="1.5" Click="Topping_Click"/>
                    </UniformGrid>
                </StackPanel>

                <!-- 右下：説明欄 -->
                <StackPanel Grid.Row="1"
            Grid.Column="1"
            Margin="5,4,10,4"
            VerticalAlignment="Top">

                    <TextBlock x:Name="SidebarLine1"
               Text="当店の小ラーメンは"
               FontSize="8"
               FontWeight="Bold"
               TextAlignment="Center"
               HorizontalAlignment="Center"/>

                    <TextBlock Text="普通のラーメン屋さん"
               FontSize="8"
               FontWeight="Bold"
               TextAlignment="Center"
               HorizontalAlignment="Center"
               Margin="0,0,0,0"/>

                    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,-2,0,3">
                        <TextBlock Text="の"
                   FontSize="8"
                   FontWeight="Bold"
                   VerticalAlignment="Bottom"/>
                        <TextBlock Text="大盛"
                   FontSize="17"
                   FontWeight="Bold"
                   Foreground="Red"
                   VerticalAlignment="Bottom"/>
                        <TextBlock Text="くらいあります。"
                   FontSize="7"
                   FontWeight="Bold"
                   VerticalAlignment="Bottom"/>
                    </StackPanel>

                    <!-- 初めてのお客様案内 -->
                    <Border BorderBrush="#8B4513"
            BorderThickness="3"
            CornerRadius="48"
            Background="White"
            Padding="5,4"
            Margin="0,0,0,5"
            Height="62">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                    Background="Red"
                    CornerRadius="18"
                    Width="34"
                    Height="34"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                                <TextBlock Text="初めて&#x0a;ご来店の&#x0a;お客様"
                           Foreground="White"
                           FontSize="6"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="2,0,0,0">
                                <Border Background="#FF8800"
                        CornerRadius="7"
                        Padding="3,0"
                        Margin="0,0,0,1">
                                    <TextBlock x:Name="SidebarRecommend1"
                               Text="小ラーメン か"
                               Foreground="White"
                               FontSize="8"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                                </Border>

                                <Border Background="#FFCC00"
                        CornerRadius="7"
                        Padding="3,0"
                        Margin="0,0,0,1">
                                    <TextBlock x:Name="SidebarRecommend2"
                               Text="ミニラーメン を"
                               Foreground="Black"
                               FontSize="8"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="ご注文ください。"
                           FontSize="7"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 食券回収案内 -->
                    <Border BorderBrush="#8B4513"
        BorderThickness="3"
        CornerRadius="50"
        Background="White"
        Padding="6,5"
        Height="82">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左の赤丸2つ -->
                            <StackPanel Grid.Column="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                                <Border Background="Red"
                    CornerRadius="18"
                    Width="36"
                    Height="32"
                    Margin="0,0,0,4">
                                    <TextBlock Text="麺硬め&#x0a;希望"
                           Foreground="White"
                           FontSize="6"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                                </Border>

                                <Border Background="Red"
                    CornerRadius="18"
                    Width="36"
                    Height="32">
                                    <TextBlock Text="それ以外の&#x0a;お好み"
                           Foreground="White"
                           FontSize="6"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- 右の文章 -->
                            <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="4,0,0,0">

                                <TextBlock Text="食券回収時に"
                       Foreground="Red"
                       FontSize="9"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>

                                <TextBlock Text="伝えてください"
                       FontSize="8"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>

                                <TextBlock Text="提供直前に"
                       FontSize="8"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,0"/>

                                <TextBlock Text="伺います。"
                       FontSize="8"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Viewbox>

        <!-- 下部会計エリア -->
        <Grid Grid.Row="2" Background="#EEEEEE">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="14,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 選択中メニュー表示欄 -->
                <Border Grid.Row="0"
            Background="#F7FBFF"
            BorderBrush="#CCCCCC"
            BorderThickness="1"
            CornerRadius="4"
            Padding="6">
                    <ListBox x:Name="SelectedMenuList"
                 BorderThickness="0"
                 Background="Transparent"
                 FontSize="10"
                 Foreground="#333333"/>
                </Border>

                <!-- 金額表示 -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Grid Margin="0,2">
                        <TextBlock Text="お預かり"
                       FontSize="8"
                       Foreground="#666666"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>
                        <TextBlock x:Name="TextDeposit"
                       Text="￥ 0"
                       FontSize="12"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,2">
                        <TextBlock Text="商品合計"
                       FontSize="10"
                       Foreground="#666666"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"/>
                        <TextBlock x:Name="TextTotal"
                       Text="￥ 0"
                       FontSize="26"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2,0,0" IsEnabled="False" Opacity="0.55">
                        <Button Content="10,000" Margin="1" Padding="5,2" FontSize="9" Click="Money_Click" Tag="10000"/>
                        <Button Content="5,000" Margin="1" Padding="5,2" FontSize="9" Click="Money_Click" Tag="5000"/>
                        <Button Content="2,000" Margin="1" Padding="5,2" FontSize="9" Click="Money_Click" Tag="2000"/>
                        <Button Content="1,000" Margin="1" Padding="5,2" FontSize="9" Click="Money_Click" Tag="1000"/>
                        <Button Content="電子マネー"
                    Margin="6,1,1,1"
                    Padding="6,2"
                    FontSize="9"
                    FontWeight="Bold"
                    Background="#CCCCCC"
                    Click="Money_Click"
                    Tag="0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" Margin="4,8,10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,4">
                    <Button Margin="1" Padding="2" Click="Reset_Click">
                        <StackPanel>
                            <TextBlock Text="↩" HorizontalAlignment="Center" FontSize="12"/>
                            <TextBlock Text="はじめから&#x0a;やりなおす"
                                       FontSize="7"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Margin="1" Padding="2">
                        <StackPanel>
                            <TextBlock Text="□" HorizontalAlignment="Center" FontSize="12"/>
                            <TextBlock Text="領収書" FontSize="7" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <CheckBox Grid.Row="1"
                          Content="領収証を発行する"
                          FontSize="9"
                          Margin="2,0,0,4"
                          VerticalAlignment="Center"/>

                <Button Grid.Row="2"
                        Content="会計へ進む"
                        Background="#009944"
                        Foreground="White"
                        FontSize="24"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="Issue_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#007733"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#005522"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
